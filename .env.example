# Environment Configuration — AI QA Agent
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── Application Under Test ────────────────────────────────────────────────────
BASE_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
QA_USERNAME=your-test-email@example.com
QA_PASSWORD=your-test-password

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true             # true | false
TIMEOUT=30000             # milliseconds

# ── Evidence ─────────────────────────────────────────────────────────────────
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_RETRY=true

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai       # openai | anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o          # or claude-3-5-sonnet-20241022

# ── Reporting ─────────────────────────────────────────────────────────────────
REPORT_DIR=reports
EVIDENCE_DIR=evidence
